{
  "name": "nocode-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "No-Code Platform monorepo: shared IDE core plus desktop (Tauri) and web IDE frontends.",
  "workspaces": [
    "packages/*",
    "apps/ide-tauri",
    "apps/ide-web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @nocode/ide-web",
    "dev:desktop": "npm run dev --workspace nocode-ide",
    "tauri:dev": "npm run tauri:dev --workspace nocode-ide",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @nocode/ide-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @nocode/ide-core",
    "format": "npm run format --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
