//! Rendered form page for `{{name}}`.

use leptos::prelude::*;
use leptos::ev::SubmitEvent;

use crate::api;

#[component]
pub fn {{this.pascal}}() -> impl IntoView {
    let (error, set_error) = signal(Option::<String>::None);
    let (done, set_done) = signal(false);
{{#each fields}}{{#if is_submittable}}    let (input_{{@index}}, set_input_{{@index}}) = signal(String::new());
{{/if}}{{/each}}
    let on_submit = move |ev: SubmitEvent| {
        ev.prevent_default();
        let payload = serde_json::json!({
{{#each fields}}{{#if is_submittable}}            "{{name}}": input_{{@index}}.get(),
{{/if}}{{/each}}        });
        leptos::task::spawn_local(async move {
            match api::submit_{{this.snake}}(&payload).await {
                Ok(_) => {
                    set_done.set(true);
                    set_error.set(None);
                }
                Err(e) => set_error.set(Some(e)),
            }
        });
    };

    view! {
        <section class="mx-auto max-w-2xl space-y-6">
            <header class="space-y-1">
                <h1 class="text-2xl font-bold">{{name}}</h1>
{{#if description}}                <p class="text-sm text-slate-600">{{description}}</p>
{{/if}}            </header>

            {move || error.get().map(|e| view! { <p class="rounded bg-red-50 p-3 text-sm text-red-700">{e}</p> })}
            {move || done.get().then(|| view! { <p class="rounded bg-green-50 p-3 text-sm text-green-700">"Submitted."</p> })}

            <form class="grid gap-4 rounded-lg border border-slate-200 bg-white p-4" on:submit=on_submit>
{{#each fields}}                <label class="flex flex-col gap-1 text-sm">
                    <span class="font-medium text-slate-600">{{label}}{{#if required}} <span class="text-red-500">"*"</span>{{/if}}</span>
{{#if (eq field_type "textarea")}}                    <textarea
                        class="rounded border border-slate-300 px-2 py-1"
                        prop:value=move || input_{{@index}}.get()
                        on:input=move |ev| set_input_{{@index}}.set(event_target_value(&ev))
                    ></textarea>
{{else if (eq field_type "select")}}                    <select
                        class="rounded border border-slate-300 px-2 py-1"
                        prop:value=move || input_{{@index}}.get()
                        on:change=move |ev| set_input_{{@index}}.set(event_target_value(&ev))
                    >
                        <option value="">"Select…"</option>
{{#each options}}                        <option value="{{value}}">{{label}}</option>
{{/each}}                    </select>
{{else if (eq field_type "boolean")}}                    <input
                        type="checkbox"
                        prop:checked=move || input_{{@index}}.get() == "true"
                        on:change=move |ev| set_input_{{@index}}.set(event_target_checked(&ev).to_string())
                    />
{{else if (eq field_type "file")}}                    <input
                        class="rounded border border-slate-300 px-2 py-1"
                        type="file"
                    />
{{else}}                    <input
                        class="rounded border border-slate-300 px-2 py-1"
                        type="{{input_type}}"
                        prop:value=move || input_{{@index}}.get()
                        on:input=move |ev| set_input_{{@index}}.set(event_target_value(&ev))
                    />
{{/if}}                </label>
{{/each}}                <div class="flex justify-end">
                    <button class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" type="submit">
                        "Submit"
                    </button>
                </div>
            </form>
        </section>
    }
}
