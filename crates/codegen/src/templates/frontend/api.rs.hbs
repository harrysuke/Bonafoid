//! Thin typed HTTP client for the generated backend API.

use gloo_net::http::Request;

use crate::types::*;

/// Base URL of the backend. Override at compile time with `API_BASE=...`.
const API_BASE: &str = match option_env!("API_BASE") {
    Some(base) => base,
    None => "http://127.0.0.1:3000",
};

async fn read_json<T: serde::de::DeserializeOwned>(
    resp: gloo_net::http::Response,
) -> Result<T, String> {
    if !resp.ok() {
        return Err(format!("request failed with status {}", resp.status()));
    }
    resp.json::<T>().await.map_err(|e| e.to_string())
}

pub async fn health() -> Result<serde_json::Value, String> {
    let resp = Request::get(&format!("{}/health", API_BASE))
        .send()
        .await
        .map_err(|e| e.to_string())?;
    read_json(resp).await
}

