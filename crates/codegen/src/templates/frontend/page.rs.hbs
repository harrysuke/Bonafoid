//! Rendered page component for `{{this.name_comment}}`.

use leptos::prelude::*;
// A page with no API data source and no API action uses neither of these.
#[allow(unused_imports)]
use serde_json::Value;

#[allow(unused_imports)]
use crate::api;

#[component]
pub fn {{this.pascal}}() -> impl IntoView {
    // Data source signals
{{#each data_sources}}{{#if (eq source_type.type "api")}}    #[allow(unused_variables)]
    let ({{this.snake}}, set_{{this.snake}}) = signal(Value::Null);
    #[allow(unused_variables)]
    let load_{{this.snake}} = move || {
        leptos::task::spawn_local(async move {
            match api::request("{{source_type.method}}", "{{source_type.endpoint}}", None::<&Value>).await {
                Ok(v) => set_{{this.snake}}.set(v),
                Err(e) => leptos::logging::log!("Failed to load {{this.name_rust}}: {:?}", e),
            }
        });
    };
{{/if}}{{/each}}

    // Page actions
    //
    // Each action becomes a closure. The name is `action_<index>_<snake>`
    // because the action's display name ("Create Record") is not a valid
    // Rust identifier and two actions can share a name.
{{#each actions}}    #[allow(dead_code, unused_variables)]
    let action_{{@index}}_{{name_snake}} = move || {
{{#if (eq config.type "navigate")}}        leptos::task::spawn_local(async move {
            leptos_router::use_navigate()("{{config.path}}", Default::default());
        });
{{else if (eq config.type "call_api")}}{{#if config.path}}        leptos::task::spawn_local(async move {
            let _ = api::request("{{config.method}}", "{{config.path}}", None::<&Value>).await;
        });
{{else}}        // This action targets a data source with no HTTP endpoint, so
        // there is nothing to call.
        leptos::logging::log!("Action {{name}} has no endpoint to call");
{{/if}}{{else}}        leptos::logging::log!("Action {{name}} ({{config.type}}) not yet implemented");
{{/if}}    };
{{/each}}

    // Load auto-load data sources
{{#each data_sources}}{{#if (and (eq source_type.type "api") auto_load)}}    load_{{this.snake}}();
{{/if}}{{/each}}

    view! {
        <section class="mx-auto max-w-6xl px-4 py-8 space-y-8">
            <header class="space-y-2">
                <h1 class="text-3xl font-bold">{{this.name_rust}}</h1>
{{#if description}}                <p class="text-slate-600">{{description}}</p>
{{/if}}            </header>

            {{#each tokens}}{{#if is_open}}<{{tag}} {{{attrs}}}>
{{else if is_close}}</{{tag}}>
{{else if is_void}}<{{tag}} {{{attrs}}} />
{{else}}{{text}}{{/if}}{{/each}}
        </section>
    }
}