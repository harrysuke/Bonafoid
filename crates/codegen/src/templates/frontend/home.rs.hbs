//! Landing page listing the available entities.

use leptos::prelude::*;
use leptos_router::components::A;

#[component]
pub fn Home() -> impl IntoView {
    view! {
        <section class="space-y-6">
            <header class="space-y-2">
                <h1 class="text-3xl font-bold">{{project.name}}</h1>
                <p class="text-slate-600">"Generated with the No-Code IDE."</p>
            </header>
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
{{#each entities}}                <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:shadow">
                    <A href="/{{this.snake}}">
                        <span class="text-lg font-medium text-blue-600">{{this.plural_name}}</span>
                    </A>
                    <p class="mt-1 text-sm text-slate-500">"Manage records"</p>
                </li>
{{/each}}{{#each forms}}                <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:shadow">
                    <A href="/forms/{{this.snake}}">
                        <span class="text-lg font-medium text-blue-600">{{this.name}}</span>
                    </A>
                    <p class="mt-1 text-sm text-slate-500">"Fill in this form"</p>
                </li>
{{/each}}{{#each pages}}                <li class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm hover:shadow">
                    <A href="{{this.route}}">
                        <span class="text-lg font-medium text-blue-600">{{this.name}}</span>
                    </A>
                    <p class="mt-1 text-sm text-slate-500">"View page"</p>
                </li>
{{/each}}            </ul>
        </section>
    }
}
