{{/each}}/// Payload for creating a {{entity.name}}.
///
/// Binary fields are omitted: a browser gives a file input a path, not the
/// bytes, so there is no value the frontend could send that would
/// deserialize into a `Vec<u8>`. Set the column directly until there is an
/// upload endpoint.
#[derive(Debug, Serialize, Deserialize)]
pub struct Create{{entity.pascal}} {
{{#each entity.fields}}{{#unless is_primary_key}}{{#if can_edit}}    pub {{rust_ident}}: {{rust_field_type}},
{{/if}}{{/unless}}{{/each}}}

/// Payload for partially updating a {{entity.name}}.
///
/// Each field is `Option<base>`, matching the generated frontend DTOs: a `None`
/// field is left unchanged. Wrapping the already-optional `rust_field_type`
/// produced `Option<Option<T>>`, which disagreed with the frontend DTOs; the
/// trade-off is that an explicit NULL is indistinguishable from "unchanged".
#[derive(Debug, Serialize, Deserialize)]
pub struct Update{{entity.pascal}} {
{{#each entity.fields}}{{#unless is_primary_key}}{{#if can_edit}}    pub {{rust_ident}}: Option<{{rust_type}}>,
{{/if}}{{/unless}}{{/each}}}

/// API representation of a {{entity.name}}.
#[derive(Debug, Serialize, Deserialize)]
pub struct {{entity.pascal}}Response {
{{#each entity.fields}}    pub {{rust_ident}}: {{rust_field_type}},
{{/each}}}

impl From<Model> for {{entity.pascal}}Response {
    fn from(model: Model) -> Self {
        Self {
{{#each entity.fields}}            {{rust_ident}}: model.{{rust_ident}},
{{/each}}        }
    }
}
